cmake_minimum_required(VERSION 3.20)
if(NOT EXISTS "${BINARY}" OR NOT EXISTS "${OBJDUMP}")
    message(FATAL_ERROR "PE audit requires the built binary and an objdump executable")
endif()
# Decode only the PE headers, independently of objdump's human-readable formatting.
function(pe_value hex offset count result)
    math(EXPR start "${offset} * 2")
    math(EXPR last "${start} + ${count} * 2")
    string(LENGTH "${hex}" length)
    if(last GREATER length)
        message(FATAL_ERROR "Truncated PE header")
    endif()
    set(value 0)
    math(EXPR end "${count} - 1")
    foreach(i RANGE 0 ${end})
        math(EXPR at "${start} + ${i} * 2")
        string(SUBSTRING "${hex}" ${at} 2 byte)
        math(EXPR value "${value} + (0x${byte} << (${i} * 8))")
    endforeach()
    set(${result} ${value} PARENT_SCOPE)
endfunction()
file(READ "${BINARY}" dos LIMIT 64 HEX)
pe_value("${dos}" 0 2 mz)
pe_value("${dos}" 60 4 offset)
file(SIZE "${BINARY}" size)
math(EXPR end "${offset} + 264")
if(NOT mz EQUAL 23117 OR offset LESS 64 OR end GREATER size)
    message(FATAL_ERROR "Invalid DOS/PE header")
endif()
file(READ "${BINARY}" pe OFFSET ${offset} LIMIT 264 HEX)
pe_value("${pe}" 0 4 signature)
pe_value("${pe}" 4 2 machine)
pe_value("${pe}" 24 2 magic)
pe_value("${pe}" 92 2 subsystem)
pe_value("${pe}" 94 2 dll_flags)
pe_value("${pe}" 22 2 flags)
if(ARCHITECTURE STREQUAL "x86" AND machine EQUAL 332 AND magic EQUAL 267)
    set(directories 120)
    math(EXPR laa "${flags} & 32")
    if(NOT laa)
        message(FATAL_ERROR "x86 large-address awareness missing")
    endif()
elseif(ARCHITECTURE STREQUAL "x64" AND machine EQUAL 34404 AND magic EQUAL 523)
    set(directories 136)
else()
    message(FATAL_ERROR "PE architecture mismatch; expected ${ARCHITECTURE}")
endif()
math(EXPR mitigation "${dll_flags} & 320")
if(NOT signature EQUAL 17744 OR NOT mitigation EQUAL 320)
    message(FATAL_ERROR "Invalid signature or missing ASLR/DEP")
endif()
if(DEFINED SUBSYSTEM AND NOT subsystem EQUAL SUBSYSTEM)
    message(FATAL_ERROR "Incorrect GUI/console subsystem")
endif()
foreach(index 6 13 14)
    math(EXPR at "${directories} + ${index} * 8")
    pe_value("${pe}" ${at} 4 directory_${index})
endforeach()
pe_value("${pe}" 16 4 symbols)
if(directory_13 OR directory_14)
    message(FATAL_ERROR "CLR or unreviewed delay-load imports rejected")
endif()
if(CONFIGURATION STREQUAL "Release" AND (directory_6 OR symbols))
    message(FATAL_ERROR "Release PE retains debug directory / COFF symbols")
endif()
execute_process(COMMAND "${OBJDUMP}" -p "${BINARY}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "objdump failed: ${errors}")
endif()
string(REGEX MATCHALL "DLL Name:[ \t]*[^\r\n]+" imports "${output}")
if(NOT imports)
    message(FATAL_ERROR "PE audit found no imports in ${BINARY}")
endif()
set(allowed kernel32.dll user32.dll gdi32.dll gdiplus.dll comctl32.dll shell32.dll ole32.dll oleaut32.dll
    advapi32.dll shlwapi.dll version.dll dbghelp.dll dwmapi.dll cabinet.dll ntdll.dll ucrtbase.dll msvcrt.dll bcrypt.dll rpcrt4.dll)
set(crt_contract "^api-ms-win-crt-(conio|convert|environment|filesystem|heap|locale|math|multibyte|private|process|runtime|stdio|string|time|utility)-l1-1-0[.]dll$")
set(report "")
foreach(item IN LISTS imports)
    string(REGEX REPLACE "DLL Name:[ \t]*" "" dll "${item}")
    string(STRIP "${dll}" dll)
    string(TOLOWER "${dll}" dll)
    if(NOT dll IN_LIST allowed AND NOT dll MATCHES "${crt_contract}")
        message(FATAL_ERROR "Non-system/unreviewed DLL import rejected: ${dll} in ${BINARY}")
    endif()
    string(APPEND report "${dll}\n")
endforeach()
set(post1507 "GetDpiForWindow|GetDpiForSystem|GetSystemDpiForProcess|GetSystemMetricsForDpi|AdjustWindowRectExForDpi|SetProcessDpiAwarenessContext|SetThreadDpiAwarenessContext|GetThreadDpiAwarenessContext|GetAwarenessFromDpiAwarenessContext|AreDpiAwarenessContextsEqual|IsValidDpiAwarenessContext|EnableNonClientDpiScaling|GetDpiAwarenessContextForProcess|SetThreadDescription|GetThreadDescription|IsWow64Process2|GetTempPath2W|GetTempPath2A")
if(output MATCHES "[ \t](${post1507})[ \t]*[\r\n]")
    message(FATAL_ERROR "Static post-1507 API import rejected: ${CMAKE_MATCH_1}")
endif()
file(WRITE "${BINARY}.imports.txt" "${report}")
file(WRITE "${BINARY}.pe.txt" "${output}")
# Only approved packed resources are exempt from this string heuristic. Native DLL,
# static CRT, architecture and source dynamic-loading policies remain unchanged.
pe_value("${pe}" 6 2 section_count)
pe_value("${pe}" 20 2 optional_size)
if(magic EQUAL 267)
    set(minimum_optional 224)
else()
    set(minimum_optional 240)
endif()
math(EXPR section_table "${offset} + 24 + ${optional_size}")
math(EXPR section_end "${section_table} + ${section_count} * 40")
if(optional_size LESS minimum_optional OR section_count LESS 1 OR section_count GREATER 96 OR section_end GREATER size)
    message(FATAL_ERROR "Invalid PE section table")
endif()
set(forbidden_ascii_hex
    "[57]7[46]5[46]2[57]6[46]9[46]5[57]732"
    "[46]d[57]3[46]5[46]4[46]7[46]5[57]7[46]5[46]2[57]6[46]9[46]5[57]732"
    "[46]d[46]9[46]3[57]2[46]f[57]3[46]f[46]6[57]4[46]5[46]4[46]7[46]5[57]7[46]5[46]2[57]6[46]9[46]5[57]732[57]2[57]5[46]e[57]4[46]9[46]d[46]5[46]9[46]e[57]3[57]4[46]1[46]c[46]c[46]5[57]2")
math(EXPR last_section "${section_count} - 1")
foreach(section_index RANGE 0 ${last_section})
    math(EXPR section_at "${section_table} + ${section_index} * 40")
    file(READ "${BINARY}" section OFFSET ${section_at} LIMIT 40 HEX)
    string(SUBSTRING "${section}" 0 16 section_name)
    pe_value("${section}" 16 4 raw_size)
    pe_value("${section}" 20 4 raw_offset)
    if(raw_size EQUAL 0)
        continue()
    endif()
    math(EXPR raw_end "${raw_offset} + ${raw_size}")
    if(raw_offset LESS section_end OR raw_end GREATER size)
        message(FATAL_ERROR "Invalid PE section bounds")
    endif()
    if(section_name STREQUAL "2e72737263000000") # .rsrc only
        continue()
    endif()
    file(READ "${BINARY}" section_bytes OFFSET ${raw_offset} LIMIT ${raw_size} HEX)
    foreach(forbidden IN LISTS forbidden_ascii_hex)
        if(section_bytes MATCHES "${forbidden}")
            message(FATAL_ERROR "Browser runtime string found in native PE section")
        endif()
    endforeach()
    unset(section_bytes)
endforeach()
if(DEFINED SOURCE_ROOT)
    set(active src/app/main.cpp resources/app.rc src/core/service.cpp src/core/sync_engine.cpp src/core/file_ops.cpp
        src/core/path_policy.cpp src/core/logger.cpp src/core/config.cpp src/core/monitor.cpp src/core/game_detect.cpp src/core/tool_manager.cpp)
    file(GLOB_RECURSE headers RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/src/app/*.h" "${SOURCE_ROOT}/src/common/*.h" "${SOURCE_ROOT}/src/core/*.h")
    list(APPEND active ${headers})
    foreach(relative IN LISTS active)
        file(READ "${SOURCE_ROOT}/${relative}" code)
        string(REGEX REPLACE "/[*]([^*]|[*]+[^*/])*[*]+/" "" code "${code}")
        string(REGEX REPLACE "(^|\n)[ \t]*//[^\n]*" "\\1" code "${code}")
        if(code MATCHES "WebView2|WebView2Loader|msedgewebview2|RuntimeInstaller[.]exe|ui_index[.]html")
            message(FATAL_ERROR "Browser runtime reference in active input: ${relative}")
        endif()
        # Permit only a fixed OS DLL basename and the System32-only search flag.
        string(REGEX MATCHALL "(LoadLibrary(Ex)?[AW]?|LoadPackagedLibrary|LdrLoadDll)[ \t\r\n]*[(][^;]*" loads "${code}")
        foreach(call IN LISTS loads)
            if(NOT call MATCHES "^LoadLibraryExW[ \t\r\n]*[(][ \t\r\n]*L\"([a-zA-Z0-9_.-]+)\"[ \t\r\n]*,[ \t\r\n]*(nullptr|NULL|0)[ \t\r\n]*,[ \t\r\n]*LOAD_LIBRARY_SEARCH_SYSTEM32[ \t\r\n]*[)]")
                message(FATAL_ERROR "Unreviewed dynamic library loading path in ${relative}: ${call}")
            endif()
            string(TOLOWER "${CMAKE_MATCH_1}" loaded_dll)
            if(NOT loaded_dll IN_LIST allowed)
                message(FATAL_ERROR "Unreviewed dynamically loaded DLL: ${loaded_dll}")
            endif()
        endforeach()
    endforeach()
endif()
message(STATUS "PE architecture, system imports, 1507 API and native-runtime audit passed: ${BINARY}")
